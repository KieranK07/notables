Notables.app/
build/
dist/
.build/
DerivedData/
*.dSYM/
node_modules/
__pycache__/
*.pyc
venv/
.venv/

# --- Editor / OS -------------------------------------------------------------
.DS_Store
*.bak
*.swp
*~
